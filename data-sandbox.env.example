# Existing SecretPad container installed by the autonomy all-in-one package.
SOURCE_SECRETPAD_CONTAINER=root-kuscia-autonomy-secretpad-alice
SECRETPAD_CONTAINER=root-kuscia-autonomy-secretpad-alice
SECRETPAD_IMAGE=data-sandbox-secretpad:mvp
SECRETPAD_PORT=8088

# Set true only after registering a compatible Kuscia AppImage.
DATA_SANDBOX_KUSCIA_ENABLED=false

# Required NAS locations.
DATA_SANDBOX_SNAPSHOT_ROOT=/nas/Misc/data-sandbox/snapshots
DATA_SANDBOX_BACKUP_ROOT=/nas/Misc/data-sandbox/backups
DATA_SANDBOX_STATUS_SYNC_MS=30000

# Optional override when the source container cannot be inspected.
DOCKER_NETWORK=kuscia-exchange

# Independent local P2P test partner. Its runtime data is stored on NAS, not
# under /root or Docker managed volumes.
DATA_SANDBOX_RUNTIME_ROOT=/nas/Misc/data-sandbox/runtime
# containerd/K3s require a local Linux filesystem with overlayfs support.
DATA_SANDBOX_LOCAL_RUNTIME_ROOT=/data/xzh/Workspaces/Misc/data-sandbox/.runtime
DATA_SANDBOX_KUSCIA_IMAGE=secretflow-registry.cn-hangzhou.cr.aliyuncs.com/secretflow/kuscia:0.13.0b0
DATA_SANDBOX_PARTNER_KUSCIA_PREFIX=data-sandbox-kuscia-autonomy
DATA_SANDBOX_PARTNER_SECRETPAD_PREFIX=data-sandbox-secretpad
