# Existing SecretPad container installed by the autonomy all-in-one package.
SOURCE_SECRETPAD_CONTAINER=root-kuscia-autonomy-secretpad-alice
SECRETPAD_CONTAINER=root-kuscia-autonomy-secretpad-alice
SECRETPAD_IMAGE=data-sandbox-secretpad:mvp
SECRETPAD_PORT=8088

# Set true only after registering a compatible Kuscia AppImage.
DATA_SANDBOX_KUSCIA_ENABLED=false

# Required NAS locations.
DATA_SANDBOX_SNAPSHOT_ROOT=/nas/Misc/data-sandbox/snapshots
DATA_SANDBOX_BACKUP_ROOT=/nas/Misc/data-sandbox/backups
DATA_SANDBOX_STATUS_SYNC_MS=30000

# Optional override when the source container cannot be inspected.
DOCKER_NETWORK=kuscia-exchange

# Independent local P2P test partner. Its runtime data is stored on NAS, not
# under /root or Docker managed volumes.
DATA_SANDBOX_RUNTIME_ROOT=/nas/Misc/data-sandbox/runtime
# containerd/K3s require a local Linux filesystem with overlayfs support.
DATA_SANDBOX_LOCAL_RUNTIME_ROOT=/data/xzh/Workspaces/Misc/data-sandbox/.runtime
DATA_SANDBOX_KUSCIA_IMAGE=secretflow-registry.cn-hangzhou.cr.aliyuncs.com/secretflow/kuscia:0.13.0b0
DATA_SANDBOX_PARTNER_KUSCIA_PREFIX=data-sandbox-kuscia-autonomy
DATA_SANDBOX_PARTNER_SECRETPAD_PREFIX=data-sandbox-secretpad

# Local database integration-test configuration. The shell helpers in this
# directory load these values automatically. Copy this file to
# data-sandbox.env and adjust it for a different host or image mirror.
DB_TEST_PASSWORD=passwd
DB_MYSQL55_USER=mysql
DB_MYSQL80_USER=mysql
DB_POSTGRES_USER=postgresql
DB_GREATSQL_USER=greatsql
DB_OPENGAUSS_USER=opengauss_remote

# Each service has its own credential. DB_TEST_PASSWORD is only the
# compatibility fallback used when a service-specific password is omitted.
DB_MYSQL55_PASSWORD=passwd
DB_MYSQL80_PASSWORD=passwd
DB_POSTGRES_PASSWORD=passwd
DB_GREATSQL_PASSWORD=passwd
DB_OPENGAUSS_PASSWORD=passwd

DB_MYSQL55_DATABASE=demo
DB_MYSQL80_DATABASE=demo
# DB_MYSQL_DATABASE is a legacy fallback for both MySQL versions.
DB_MYSQL_DATABASE=demo
DB_POSTGRES_DATABASE=demo
DB_GREATSQL_DATABASE=demo
DB_OPENGAUSS_DATABASE=postgres

DB_MYSQL55_PORT=13306
DB_MYSQL80_PORT=13307
DB_POSTGRES_PORT=15432
DB_GREATSQL_PORT=13308
DB_OPENGAUSS_PORT=15433
DB_GREATSQL_SOCKET=/data/GreatSQL/mysql.sock

# Local tags used by start-test-databases.sh and as the destination tags in
# pull-database-images.sh.
DB_MYSQL55_IMAGE=mysql:5.5
DB_MYSQL80_IMAGE=mysql:9.7.2
DB_POSTGRES_IMAGE=postgres:18.6
DB_GREATSQL_IMAGE=greatsql/greatsql:8.4.4-5
DB_OPENGAUSS_IMAGE=opengauss/opengauss:5.0.0

# Optional pull sources. These may point to a registry mirror while the
# DB_*_IMAGE values above remain stable for JDBC configuration.
DB_MYSQL55_MIRROR_IMAGE=docker.1ms.run/library/mysql:5.5
DB_MYSQL80_MIRROR_IMAGE=docker.1ms.run/library/mysql:9.7.2
DB_POSTGRES_MIRROR_IMAGE=docker.1ms.run/library/postgres:18.6
DB_GREATSQL_MIRROR_IMAGE=docker.1ms.run/greatsql/greatsql:8.4.4-5
DB_OPENGAUSS_MIRROR_IMAGE=docker.1ms.run/opengauss/opengauss:5.0.0

# Container names can be changed when running more than one test stack.
DB_MYSQL55_CONTAINER=ds-test-mysql55
DB_MYSQL80_CONTAINER=ds-test-mysql80
DB_POSTGRES_CONTAINER=ds-test-postgres
DB_GREATSQL_CONTAINER=ds-test-greatsql
DB_OPENGAUSS_CONTAINER=ds-test-opengauss
